# ──────────────────────────────────────────────────────────────────────
# Ethos site — variaveis de ambiente
# ──────────────────────────────────────────────────────────────────────
# Copie este arquivo para .env.local (NUNCA commitar .env.local) e
# preencha os valores. Em produção (Vercel), configure as mesmas variaveis
# em Project Settings → Environment Variables.

# Resend — chave da API, usada pelo /api/contact para enviar emails.
# Crie/obtenha em https://resend.com/api-keys
# Sem essa chave, o endpoint retorna 503 e o form mostra o fallback de
# WhatsApp/email direto.
RESEND_API_KEY=

# (opcional) Email remetente. Deve estar em um dominio verificado no Resend.
# Domain verificado: mail.somosethos.com.br (subdominio, NAO a raiz).
# Default: site@mail.somosethos.com.br
CONTACT_FROM_EMAIL=

# (opcional) Email que recebe os contatos do site.
# Pode ser endereco da raiz somosethos.com.br (recebimento usa MX da raiz).
# Default: contato@somosethos.com.br
CONTACT_TO_EMAIL=

# ──────────────────────────────────────────────────────────────────────
# Anthropic (Claude) — usado pelo /api/chat (concierge digital da Ethos).
# Crie a chave em https://platform.claude.com (formato sk-ant-...).
# Sem a chave, o widget de chat retorna 503 e oferece o formulario.
# ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# (opcional) Modelo da Claude. Default: claude-haiku-4-5 (rapido e barato).
ANTHROPIC_MODEL=

# ──────────────────────────────────────────────────────────────────────
# Ethos Hub — ingestao de leads no pipeline interno.
# Quando configurado, todo lead que chega pelo site (form ou chat do Otto)
# tambem cria um deal no hub via POST /api/ingest/lead. Sem essas envs,
# o site continua enviando o email mas nao notifica o hub.
# ──────────────────────────────────────────────────────────────────────

# (opcional) URL base do hub. Default: https://ethos-hub.vercel.app
HUB_BASE_URL=

# Token compartilhado de ingestao. O mesmo valor vai na env `SITE_INGEST_TOKEN`
# do ethos-hub. Use uma string forte (ex.: openssl rand -hex 32).
HUB_INGEST_TOKEN=
